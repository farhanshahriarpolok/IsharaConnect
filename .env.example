# ==============================================================================
# IsharaConnect Production Environment Configuration
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
SECRET_KEY=replace_with_a_secure_32_byte_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256

# PostgreSQL Database Configuration
POSTGRES_USER=ishara
POSTGRES_PASSWORD=ishara_secure_password_please_change
POSTGRES_DB=isharaconnect
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ishara:ishara_secure_password_please_change@db:5432/isharaconnect

# Redis Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# CORS Allowed Origins (JSON list format)
ALLOWED_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:8000", "http://127.0.0.1"]
